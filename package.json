{
  "name": "projectmatch",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:reset": "dotenv -e .env.development -- prisma migrate reset",
    "db:dev": "dotenv -e .env.development -- prisma migrate dev",
    "db:seed": "dotenv -e .env.development -- tsx prisma/seed.ts",
    "db:deploy": "dotenv -e .env.production -- prisma migrate deploy",
    "db:studio:dev": "dotenv -e .env.development -- prisma studio",
    "db:studio:prod": "dotenv -e .env.production -- prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "dotenv": "^18.0.8",
    "next": "16.4.1",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^10.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@typescript-eslint/eslint-plugin": "8.71.1",
    "@typescript-eslint/parser": "8.71.1",
    "@typescript-eslint/typescript-estree": "8.71.1",
    "@typescript-eslint/utils": "8.71.1",
    "@typescript-eslint/type-utils": "8.71.1",
    "@typescript-eslint/project-service": "8.71.1",
    "typescript-eslint": "8.71.1"
  }
}
