# Copy this file to .env.development and use your development database.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/projectmatch"

# Resend — academic email verification
RESEND_API_KEY="re_your_api_key"
RESEND_FROM_EMAIL="ProjectMatch <onboarding@resend.dev>"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Cloudinary — profile pictures and verification documents.
# The API key must be allowed to Create assets (Upload API) with signed uploads.
CLOUDINARY_URL="cloudinary://API_KEY:API_SECRET@CLOUD_NAME"
