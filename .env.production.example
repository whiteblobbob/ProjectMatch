# Copy this file to .env.production and set this in your production host's secret store.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/projectmatch_prod?schema=public"

# Resend — academic email verification (use a verified sending domain in production)
RESEND_API_KEY="re_your_api_key"
RESEND_FROM_EMAIL="ProjectMatch <no-reply@yourdomain.com>"
NEXT_PUBLIC_SITE_URL="https://your-production-domain.com"

# Cloudinary — profile pictures and verification documents.
# The API key must be allowed to Create assets (Upload API) with signed uploads.
CLOUDINARY_URL="cloudinary://API_KEY:API_SECRET@CLOUD_NAME"